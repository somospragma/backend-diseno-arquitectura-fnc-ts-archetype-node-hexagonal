{
  "name": "accounts-serverless",
  "version": "1.0.0",
  "description": "Arquetipo showcase Pragma Node + TypeScript serverless (AWS Lambda) hexagonal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "knip": "knip",
    "test": "jest",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "2.36.0",
    "@aws-lambda-powertools/metrics": "2.36.0",
    "@aws-lambda-powertools/tracer": "2.36.0",
    "@aws-sdk/client-dynamodb": "3.1165.0",
    "@aws-sdk/client-eventbridge": "3.1165.0",
    "@aws-sdk/client-sns": "3.1165.0",
    "@aws-sdk/lib-dynamodb": "3.1165.0",
    "zod": "4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@aws-lambda-powertools/commons": "2.36.0",
      "@typescript-eslint/typescript-estree>minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/jest": "29.5.13",
    "@types/node": "22.7.5",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "aws-sdk-client-mock": "4.1.0",
    "esbuild": "0.28.2",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "knip": "6.45.0",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "typescript": "5.6.3"
  }
}
